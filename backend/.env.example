# Copy to .env (never commit .env). Real values live only on the backend host.
AUREX_ENV=prod              # set to "dev" only locally to enable the raw-capture endpoint
TALASANJ_API_KEY=
TALASANJ_API_KEY_BACKUP=
TALASANJ_BASE_URL=https://talasanj.info/api/v1
# Set this from the provider's documented rate limit / plan:
TALASANJ_MIN_INTERVAL_S=60
HTTP_TIMEOUT_S=10
HTTP_RETRIES=2
STALE_AFTER_S=900
MAX_CHANGE_PCT=15
CLIENT_RATE_LIMIT_PER_MIN=60
