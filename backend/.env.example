# Copy to .env (never commit .env). Real values live only on the backend host.
AUREX_ENV=prod
TALASANJ_API_KEY=
TALASANJ_API_KEY_BACKUP=
TALASANJ_BASE_URL=https://talasanj.info/api/v1
TALASANJ_MIN_INTERVAL_S=60

# Twelve Data
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOLS=AAPL,MSFT,EUR/USD,GBP/USD,AUD/USD,BTC/USD,ETH/USD
TWELVEDATA_MIN_INTERVAL_S=900

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_MIN_INTERVAL_S=43200

HTTP_TIMEOUT_S=10
HTTP_RETRIES=2
STALE_AFTER_S=900
MAX_CHANGE_PCT=15
CLIENT_RATE_LIMIT_PER_MIN=60

# AI assistant (configure real values only in Render)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_S=45
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT_PER_MIN=10
ANALYSIS_CACHE_TTL_S=600

# Price history and stock infrastructure
HISTORY_DB_PATH=data/aurex.db
HISTORY_MIN_INTERVAL_S=300
HISTORY_RETENTION_DAYS=90
COLLECT_INTERVAL_S=300
ADMIN_TOKEN=
