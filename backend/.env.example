# Copy to .env (never commit .env). Real values live only on the backend host.
AUREX_ENV=prod
TALASANJ_API_KEY=
TALASANJ_API_KEY_BACKUP=
TALASANJ_BASE_URL=https://talasanj.info/api/v1
TALASANJ_MIN_INTERVAL_S=60

# Twelve Data
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOLS=AAPL,MSFT,EUR/USD,GBP/USD,AUD/USD,BTC/USD,ETH/USD
TWELVEDATA_MIN_INTERVAL_S=900

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_MIN_INTERVAL_S=43200

HTTP_TIMEOUT_S=10
HTTP_RETRIES=2
STALE_AFTER_S=900
MAX_CHANGE_PCT=15
CLIENT_RATE_LIMIT_PER_MIN=60
