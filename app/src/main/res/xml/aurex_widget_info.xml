<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: the system wakes the widget at most every 30 minutes (Android's own limit
     is 30 min), which keeps battery and data use low. The refresh button forces a fetch. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_aurex"
    android:description="@string/widget_desc" />
